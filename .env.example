# Postgres
PG_HOST=localhost
PG_PORT=5432
PG_DB=trackfinder
PG_USER=postgres
PG_PASSWORD=postgres

# Scylla
SCYLLA_HOSTS=localhost
SCYLLA_KEYSPACE=trackfinder

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=CHANGE_ME_LONG_RANDOM 
AUTH_PEPPER=CHANGE_ME_LONG_RANDOM

# Argon2
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_MB=128
ARGON2_PARALLELISM=2

# Limits
MAX_UPLOAD_BYTES=10485760
MAX_DECODED_SECONDS=30
RL_MATCH_PER_MINUTE=10
RL_MATCH_PER_DAY=100
RL_WS_MAX_CONNS_PER_USER=1
RL_WS_MAX_MSGS_PER_MIN=50
